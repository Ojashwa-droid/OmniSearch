# Required for search and answer generation
GEMINI_API_KEY=
TAVILY_API_KEY=

# Only needed for audio transcription
GROQ_API_KEY=

# The app listens only on the VM itself by default. Use an SSH tunnel to access it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Adjust these to the VM size. Java heap is capped as a percentage of the container limit.
CONTAINER_MEMORY_LIMIT=768m
CONTAINER_CPU_LIMIT=1.0
JAVA_MAX_RAM_PERCENTAGE=70
APP_LOG_LEVEL=INFO
